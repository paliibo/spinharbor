{
  "name": "@spinharbor/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm -w build:packages && nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --runInBand --forceExit",
    "test:unit": "jest --runInBand --forceExit --testPathIgnorePatterns integration",
    "test:integration": "jest --runInBand --forceExit --testPathPatterns integration",
    "test:cov": "jest --runInBand --forceExit --coverage",
    "pretest": "pnpm -w build:packages"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^11.2.8",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.8",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/platform-socket.io": "^11.2.8",
    "@nestjs/schedule": "^6.0.1",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/websockets": "^11.2.8",
    "@spinharbor/contracts": "workspace:*",
    "@spinharbor/database": "workspace:*",
    "@spinharbor/engines": "workspace:*",
    "argon2": "^0.45.1",
    "bullmq": "^5.81.5",
    "cookie": "^1.0.2",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.1.0",
    "ioredis": "^5.11.1",
    "nestjs-pino": "^4.6.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.2.8",
    "@swc/cli": "^0.7.9",
    "@swc/core": "^1.16.20",
    "@swc/jest": "^0.2.39",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.0",
    "@types/supertest": "^7.2.1",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.1",
    "jest": "^30.5.2",
    "prisma": "6.19.3",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
