# ---- Infrastructure (docker-compose exposes these host ports) ----
POSTGRES_PORT=5441
REDIS_PORT=6381
DATABASE_URL=postgresql://spinharbor:spinharbor@localhost:5441/spinharbor?schema=public
REDIS_URL=redis://localhost:6381

# ---- API ----
API_PORT=4000
API_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
NODE_ENV=development
LOG_LEVEL=info
# generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters-long
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=1209600
COOKIE_SECURE=false
# Demo-only: allows POST /wallet/reset for players
ENABLE_DEMO_RESET=true
# Demo credits granted on registration / reset (in credits, not minor units)
INITIAL_DEMO_CREDITS=10000

# ---- Web ----
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000
